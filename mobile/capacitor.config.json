{
  "appId": "com.swapiles.app",
  "appName": "Swap'Îles",
  "webDir": "www",
  "server": {
    "url": "https://swapiles.com",
    "cleartext": false,
    "androidScheme": "https",
    "iosScheme": "https",
    "errorPath": "error.html"
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#10665E",
      "showSpinner": false,
      "spinnerColor": "#ffffff",
      "androidSpinnerStyle": "large"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "appendUserAgent": "SwapilesApp"
}
